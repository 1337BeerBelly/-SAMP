# Generated Pawn binaries are ignored, except the current build kept for direct download.
/gamemodes/*.amx
!/gamemodes/dm_tdm.amx

# Local compiler/toolchain and temporary build output.
/.tools/
/build/
/dist/
/artifacts/

# Server runtime files and logs.
/omp-server*
/server_log.txt
/log.txt
/crashinfo.txt
